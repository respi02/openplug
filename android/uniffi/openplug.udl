// OpenPlug core — intended UniFFI surface (scaffold).
// The core still needs a thin ffi.rs facade implementing these.

namespace openplug {
};

[Error]
enum ConnError { "Io", "Protocol", "Auth", "Record" };

// Implemented on the foreign (Kotlin/Swift) side, backed by a BluetoothSocket
// (Android RFCOMM/SPP) or a CBPeripheral characteristic (iOS BLE GATT).
callback interface Transport {
    [Throws=ConnError]
    void send(sequence<u8> data);
    [Throws=ConnError]
    sequence<u8> recv(u32 max_len);
};

interface DongleSession {
    [Throws=ConnError]
    void send_app(sequence<u8> data);
    [Throws=ConnError]
    sequence<u8> recv_app();
};

// Establish the TLS-SRP session over the given transport using the label PIN.
namespace openplug {
    [Throws=ConnError]
    DongleSession connect(Transport transport, string pin);
};
